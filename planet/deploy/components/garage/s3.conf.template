# S3 listener for the in-cluster Garage. Requests pass through unmodified: SigV4 signs the
# Host header, the raw path and any other header the client chose to sign (Origin included).

upstream garage_s3 {
    server garage.planet-storage.svc:3900;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=s3_req:1m rate=200r/s;

server {
    listen 8081;
    client_max_body_size 0;

    # The bucket CORS policy of planet/docs/storage-setup.md and client/src/planet/s3/setup.ts.
    set $planet_cors_methods "GET, PUT, POST, DELETE, HEAD";
    set $planet_cors_headers "authorization, content-type, content-md5, content-disposition, range, if-match, if-none-match, x-amz-date, x-amz-content-sha256, x-amz-security-token, x-amz-copy-source, x-amz-copy-source-range, x-amz-user-agent";
    set $planet_cors_expose "ETag, Content-Length, Content-Range, Accept-Ranges, Date, x-amz-request-id, x-amz-version-id, x-amz-bucket-region";

    if ($origin_rejected) {
        return 403;
    }
    if ($cors_preflight) {
        return 204;
    }

    limit_req zone=s3_req burst=400 nodelay;
    limit_req_status 503;

    location / {
        proxy_pass http://garage_s3;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
